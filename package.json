{
  "name": "magpie-search1api",
  "version": "0.1.0",
  "description": "Search1API search, news and web tools for Magpie, with OAuth and API key sign-in",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/index.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/superagents-lab/magpie-search1api.git"
  },
  "homepage": "https://github.com/superagents-lab/magpie-search1api#readme",
  "bugs": {
    "url": "https://github.com/superagents-lab/magpie-search1api/issues"
  },
  "keywords": [
    "magpie",
    "magpie-plugin",
    "magpie-tools",
    "opencode",
    "opencode-plugin",
    "search1api",
    "mcp",
    "web-search",
    "oauth"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:magpie": "npm run build && node --test tests/magpie/*.test.mjs",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.18.4",
    "@search1api/client": "^0.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22"
  }
}
